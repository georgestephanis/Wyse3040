# Default build settings. Override any of these in local/build.env (gitignored).

WYSE_SUITE=trixie
WYSE_MIRROR=http://deb.debian.org/debian
WYSE_HOSTNAME=wyse3040
WYSE_TIMEZONE=America/New_York
WYSE_LOCALE=en_US.UTF-8
WYSE_XKB_LAYOUT=us

# Size of the root partition in the image, in MiB, or "auto" (the installed
# size plus 20% and 512 MiB of headroom). The image is kept small so it
# flashes fast; the root partition grows to fill the eMMC on first boot.
WYSE_ROOT_MB=auto
WYSE_ESP_MB=256

# Game/desktop streaming apps, installed from Flathub at build time and added
# to the kiosk menu. Space-separated Flatpak IDs; leave empty for none.
#   com.valvesoftware.SteamLink       Steam Link (stream from Steam on your PC)
#   com.moonlight_stream.Moonlight    Moonlight (Sunshine / GeForce hosts)
#   io.github.streetpea.Chiaki4deck   chiaki-ng (PlayStation 4/5 Remote Play)
WYSE_FLATPAKS="com.valvesoftware.SteamLink com.moonlight_stream.Moonlight io.github.streetpea.Chiaki4deck"

# Admin access (at least one is required; set in local/, never here):
#   local/authorized_keys          SSH public key(s) for the "admin" user
#   WYSE_ADMIN_PASSWORD_HASH=...   in local/build.env, from: openssl passwd -6
